# Copy file ini ke .env.local dan isi nilainya

# === Sanity ===
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Token tulis (HANYA untuk script/migrasi server-side, JANGAN expose ke client)
SANITY_API_WRITE_TOKEN=

# === Legacy admin (akan dihapus setelah Sanity siap) ===
ADMIN_PASSWORD=isi_password_kamu_disini
ADMIN_SESSION_TOKEN=isi_random_string_panjang_disini
